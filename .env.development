# ─────────────────────────────────────────────────────────────────
# EduPath Frontend — Environment Configuration
#
# DEVELOPMENT (default): Uses mock data. No backend required.
# PRODUCTION: Set VITE_USE_REAL_API=true and provide VITE_API_BASE_URL
# ─────────────────────────────────────────────────────────────────

# Set to true when real backend APIs are ready
VITE_USE_REAL_API=false

# Your backend API base URL (provided by your backend developer)
# VITE_API_BASE_URL=https://your-api.example.com

# App info
VITE_APP_NAME=EduPath
VITE_APP_VERSION=0.1.0

